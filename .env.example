# ==============================================================================
# ShiftMate Environment Configuration Example
# ==============================================================================

# Database connection URL (defaults to local SQLite database if omitted)
DATABASE_URL=sqlite:///./shiftmate.db

# Optional Google Gemini API key for Grounded Operator Assistant.
# If omitted or invalid, ShiftMate automatically and deterministically falls back
# to the grounded domain heuristic assistant with zero downtime.
GEMINI_API_KEY=

# Backend server port
PORT=8000

# Backend server host
HOST=127.0.0.1

# Frontend API base URL (used during Vite development & build)
VITE_API_BASE_URL=http://localhost:8000
