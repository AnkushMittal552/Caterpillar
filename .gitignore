# ==============================================================================
# ShiftMate Root .gitignore
# ==============================================================================

# Node dependencies & frontend production artifacts
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# Local databases & persistent runtime state
*.db
*.sqlite
*.sqlite3
data/

# Environment configurations (protect secrets; keep .env.example)
.env
.env.*
!.env.example

# IDE, OS & editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp files
logs/
*.log
tmp/
temp/
